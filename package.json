{
  "name": "dsh-flow-queue",
  "version": "0.7.0",
  "description": "Visual flow editor for DeepSeek Harness: draw prompts, model switches, commands, condition branches, loops, checkpoints and subagent fan-outs as one graph; every step runs only at a turn boundary, so an in-flight request and its retries keep their model.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.1 <0.3.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar-right"]
    }
  },
  "author": "Eclipse-NotFound",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eclipse-NotFound/dsh-flow-queue.git"
  },
  "homepage": "https://github.com/Eclipse-NotFound/dsh-flow-queue#readme",
  "bugs": {
    "url": "https://github.com/Eclipse-NotFound/dsh-flow-queue/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis-plugin",
    "flow",
    "workflow",
    "queue",
    "model-switch",
    "turn-boundary"
  ]
}
